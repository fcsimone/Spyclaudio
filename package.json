{
  "name": "spyclaudio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Spyclaudio — jogo de dedução social presencial inspirado em Spyfall, para navegador mobile.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run import:papeis && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "import:papeis": "node scripts/import-papeis.mjs",
    "check:rules": "node scripts/check-rules.mjs",
    "test": "vitest run --project=unit",
    "test:unit": "vitest run --project=unit",
    "test:rules": "firebase emulators:exec --only database --project spyclaudio-b8252 \"vitest run --project=rules\"",
    "test:e2e": "playwright test --project=android-chrome --project=iphone-safari --project=viewport-320 tests/e2e/single-device.spec.ts",
    "test:e2e:online": "firebase emulators:exec --only database,auth --project spyclaudio-b8252 \"node scripts/run-e2e-online.mjs\"",
    "emulators": "firebase emulators:start --project spyclaudio-b8252",
    "deploy:rules": "firebase deploy --only database --project spyclaudio-b8252",
    "validate": "npm run lint && npm run typecheck && npm run check:rules && npm run test:unit && npm run build"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "^15.24.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
}
